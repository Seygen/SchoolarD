# Base de données PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/schoolard"

# NextAuth — générer avec : openssl rand -base64 32
AUTH_SECRET="votre-secret-ici"
NEXTAUTH_URL="http://localhost:3000"

# Stockage de fichiers (Cloudflare R2 ou AWS S3)
STORAGE_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET_NAME="schoolard"
STORAGE_PUBLIC_URL="https://cdn.schoolard.fr"

# Email (Resend ou SMTP)
EMAIL_FROM="noreply@schoolard.fr"
RESEND_API_KEY=""

# Environnement
NODE_ENV="development"
